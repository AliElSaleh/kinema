Depends ../../SDL2.build

Compiler cl

Assembly hidapi
Extension dll

IntermediateDirectory int

Compiler.Flags /MD /Gy /W3 /Oi /O2 /Zi /EHa
Linker.Flags /INCREMENTAL:NO
Linker.Subsystem Windows

Compiler.Includes hidapi ../../include

if windows  SourceDirectories windows
if linux    SourceDirectories linux

Libraries &NativeLibs SDL2
Library.Paths ../../bin/release

# hid.c includes SDL_internal.h; SDL's dynamic API renames every SDL_* call to
# SDL_*_REAL, which only resolves when compiled into SDL2 itself. SDL_dynapi.h
# refuses SDL_DYNAMIC_API=0 from the command line, but turns itself off for
# SDL_THREAD_SAFETY_ANALYSIS (whose annotations are clang-only, inert on cl).
Compiler.Defines SDL_THREAD_SAFETY_ANALYSIS

Compiler.Defines HIDAPI_EXPORTS

if windows Compiler.Defines WIN32 NDEBUG _WINDOWS _USRDLL

Compiler.MaxCores 1