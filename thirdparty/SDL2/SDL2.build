Depends sdl2main | %%debug

Compiler cl

Assembly SDL2
Type     dynamic_lib

SourceDirectory src
IntermediateDirectory int/sdl2

BuildDirectory:debug  bin/debug
BuildDirectory:!debug bin/release

if windows|linux|macos
{
    SourceDirectories.Exclude */ps2 */n3ds */gdk */android */psp */winrt */emscripten */haiku */vita */ngage */qnx */riscos */wayland */dlopen */nacl */cocoa */stdcpp */darwin */winrt
}

if windows
{
    SourceDirectories.Exclude */linux */openbsd */os2 */unix */x11 */pthread */macosx
}

if linux
{
    SourceDirectories.Exclude */windows */macosx
}

SourceDirectories.Exclude main hidapi/* test loadso/dummy filesystem/dummy locale/dummy misc/dummy timer/dummy
SourceFiles.Exclude *_test_log.cpp *_winrt.cpp
SourceFiles.Exclude *-asm.S

SourceFiles.Exclude thread/generic/SDL_sysmutex.c thread/generic/SDL_syssem.c thread/generic/SDL_systhread.c thread/generic/SDL_systls.c

Compiler.Flags        /W3 /Ob1 /GS-
Compiler.Flags:debug  /Od /MDd /Z7
Compiler.Flags:!debug /O2 /MD

Compiler.Includes include src/hidapi src/hidapi/hidapi
Compiler.Includes.Export .
Compiler.Defines WIN32 _WINDOWS DLL_EXPORT _WINDLL

Linker.Flags      /NODEFAULTLIB /subsystem:windows
Linker.Flags:debug /DEBUG

Libraries &NativeLibs

if debug
{
    Compiler.Defines _DEBUG
}
else
{
    Compiler.Defines NDEBUG
}

option.debug
