option.mode(Release Debug)

import physx_%-(mode).buildvariables 

Compiler:windows  cl
Compiler:!windows clang

Assembly PhysX_64
Extension dll

SourceDirectory       source/physx
IntermediateDirectory int/physx
BuildDirectory        Build/%(Mode)

Compiler.Flags      $PxCompilerFlags /Gd /GR- /GS- /GF /fp:fast /wd4514 /wd4820 /wd4127 /wd4710 /wd4711 /wd4577 /wd4996

Compiler.Defines         $PxSharedDefines PX_PHYSX_FOUNDATION_EXPORTS PX_PHYSX_CORE_EXPORTS PhysX_EXPORTS
Compiler.Defines:windows $PxWindowsDefines _WINDLL PX_PHYSX_GPU_SHARED_LIB_NAME=PhysXGpu_64.dll

Linker.Flags        $PxLinkerFlags
Linker.Subsystem    Console
Linker.DelayLoadDll PhysXFoundation_64.dll PhysXCommon_64.dll

if windows
{
    SourceDirectories.Exclude unix linux
    SourceFiles.Exclude       *Linux.cpp
}
else
{
    SourceDirectories.Exclude windows
    SourceFiles.Exclude       *Windows.cpp
}

Compiler.Includes
[
    include
    include/common
    source/physx/include
    source/physx/src
    source/physx/src/buffering
    source/physx/src/device
    ../pxshared/include
    source/common/include
    source/common/src
    source/foundation/include
    source/foundation/include
    source/geomutils/src
    source/geomutils/src/convex
    source/geomutils/include
    source/geomutils/include
    source/geomutils/src
    source/geomutils/src/common
    source/geomutils/src/gjk
    source/geomutils/src/convex
    source/geomutils/src/hf
    source/geomutils/src/ccd
    source/geomutils/src/contact
    source/geomutils/src/cooking
    source/geomutils/src/distance
    source/geomutils/src/intersection
    source/geomutils/src/mesh
    source/geomutils/src/pcm
    source/geomutils/src/sweep
    source/pvd/include
    source/lowlevel/api/include
    source/lowlevel/software/include
    source/lowlevel/common/include
    source/lowlevelaabb/include
    source/lowleveldynamics/include
    source/simulationcontroller/include
    source/simulationcontroller/src
    source/physxmetadata/core/include
    source/physxmetadata/extensions/include
    source/physxgpu/include
    source/scenequery/include
]

Libraries
[
    %_NativeLibs
    PhysXFoundation_64
    PhysXCommon_64 
    LowLevel_static_64
    LowLevelAABB_static_64
    LowLevelDynamics_static_64
    PhysXTask_static_64
    SceneQuery_static_64
    SimulationController_static_64
    PhysXPvdSDK_static_64
    PhysXExtensions_static_64
    PhysXVehicle_static_64
    PhysXCharacterKinematic_static_64
]

Library.Paths Build/%(Mode)

Depends source/common.build            | mode=%mode
Depends source/pvd.build               | mode=%mode

Depends source/foundation              | mode=%mode
Depends source/lowlevel                | mode=%mode
Depends source/lowlevelaabb            | mode=%mode
Depends source/lowleveldynamics        | mode=%mode
Depends source/physxcooking            | mode=%mode
Depends source/physxextensions         | mode=%mode
Depends source/scenequery              | mode=%mode
Depends source/simulationcontroller    | mode=%mode
Depends source/task                    | mode=%mode
Depends source/physxvehicle            | mode=%mode
Depends source/physxcharacterkinematic | mode=%mode

