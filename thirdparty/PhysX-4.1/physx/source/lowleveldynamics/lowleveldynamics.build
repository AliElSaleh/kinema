option.Mode(Release Debug)

import ../../physx_%-(mode).buildvariables

Compiler:windows  cl
Compiler:!windows clang

Assembly LowLevelDynamics_static_64
Extension lib

SourceDirectory src
IntermediateDirectory ../../int/&FileName
BuildDirectory ../../Build/%Mode

Compiler.Flags   $PxCompilerFlags
Linker.Flags     $PxLinkerFlags
Linker.Subsystem Console

Compiler.Includes [
    src
    include
    common/include
    ../lowlevel/api/include
    ../lowlevel/common/include
    ../lowlevel/common/include/pipeline
    ../lowlevel/common/include/utils
    ../lowlevel/software/include
    ../../../pxshared/include
    ../../include
    ../common/src
    ../foundation/include
    ../geomutils/include
    ../geomutils/src
    ../geomutils/src/contact
    ../physx/include
]

Compiler.Includes.Export include

Compiler.Defines $PxSharedDefines

if windows Compiler.Defines $PxWindowsDefines _LIB