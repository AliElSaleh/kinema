option.Mode(Release Debug)

include ../../physx_%-(mode).buildvariables

Compiler:windows  cl
Compiler:!windows clang

Assembly PhysXCooking_64
Extension dll

SourceDirectory src
IntermediateDirectory ../../int/%_FileName
BuildDirectory ../../Build/%Mode

Compiler.Flags      $PxCompilerFlags /Gd /GR- /GS- /GF /fp:fast /wd4514 /wd4820 /wd4127 /wd4710 /wd4711 /wd4577 /wd4996
Linker.Flags        $PxLinkerFlags
Linker.Subsystem    Console
Linker.DelayLoadDll PhysXFoundation_64.dll PhysXCommon_64.dll

if windows     SourceDirectories.Exclude unix linux
if !windows    SourceDirectories.Exclude windows
if windows     SourceFiles.Exclude *Linux.cpp
if !windows    SourceFiles.Exclude *Windows.cpp

Compiler.Includes [
    include
    src
    src/convex
    src/mesh
    ../../../pxshared/include
    ../../include
    ../common/include
    ../common/src
    ../foundation/include
    ../foundation/include
    ../geomutils/src
    ../geomutils/src/convex
    ../geomutils/include
    ../geomutils/include
    ../geomutils/src
    ../geomutils/src/common
    ../geomutils/src/gjk
    ../geomutils/src/convex
    ../geomutils/src/hf
    ../geomutils/src/ccd
    ../geomutils/src/contact
    ../geomutils/src/cooking
    ../geomutils/src/distance
    ../geomutils/src/intersection
    ../geomutils/src/mesh
    ../geomutils/src/pcm
    ../geomutils/src/sweep
]

Libraries %_NativeLibs PhysXCommon_64 PhysXFoundation_64
Library.Paths ../../Build/%Mode

Compiler.Defines $PxSharedDefines PX_COOKING PX_PHYSX_COOKING_EXPORTS PX_PHYSX_COMMON_EXPORTS PX_PHYSX_FOUNDATION_EXPORTS PX_PHYSX_LOADER_EXPORTS PX_PHYSX_CORE_EXPORTS PhysXCooking_EXPORTS

if windows Compiler.Defines $PxWindowsDefines _WINDLL