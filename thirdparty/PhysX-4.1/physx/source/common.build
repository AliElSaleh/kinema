option.Mode(Release Debug)
include ../physx_%-(mode).buildvariables

Compiler:windows  cl
Compiler:!windows clang

Assembly PhysXCommon_64
Extension dll

IntermediateDirectory ../int/%_FileName
BuildDirectory        ../Build/%Mode

SourceDirectories common geomutils compiler

Compiler.Flags      $PxCompilerFlags
Linker.Flags        $PxLinkerFlags
Linker.Subsystem    Console
Linker.DelayLoadDll PhysXFoundation_64.dll

if windows     SourceDirectories.Exclude unix linux
if !windows    SourceDirectories.Exclude windows
if windows     SourceFiles.Exclude *Linux.cpp
if !windows    SourceFiles.Exclude *Windows.cpp

if _arch == x64            SourceDirectories.Exclude compiler/resource_x86
if _arch == x86            SourceDirectories.Exclude compiler/resource_x64

SourceFiles.Exclude        *PhysX.rc *PhysXCooking.rc *PhysXFoundation.rc

Compiler.Includes [
    common/include
    common/src
    ../../pxshared/include
    ../include
    foundation/include
    geomutils/src
    geomutils/src/convex
    geomutils/include
    geomutils/include
    geomutils/src
    geomutils/src/common
    geomutils/src/gjk
    geomutils/src/convex
    geomutils/src/hf
    geomutils/src/ccd
    geomutils/src/contact
    geomutils/src/cooking
    geomutils/src/distance
    geomutils/src/intersection
    geomutils/src/mesh
    geomutils/src/pcm
    geomutils/src/sweep
]

Libraries %_NativeLibs PhysXFoundation_64
Library.Paths ../Build/%Mode

Compiler.Defines $PxSharedDefines PX_PHYSX_COMMON_EXPORTS PhysXCommon_EXPORTS

if windows Compiler.Defines $PxWindowsDefines _WINDLL
