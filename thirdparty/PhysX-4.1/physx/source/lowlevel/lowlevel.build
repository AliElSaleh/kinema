option.Mode(Release Debug)

import ../../physx_%-(mode).buildvariables

Compiler:windows  cl
Compiler:!windows clang

Assembly LowLevel_static_64
Extension lib

IntermediateDirectory ../../int/&FileName
BuildDirectory ../../Build/%Mode

Compiler.Flags   $PxCompilerFlags
Linker.Flags     $PxLinkerFlags
Linker.Subsystem Console

Compiler.Includes [
    common/include
    common/include/pipeline
    common/include/collision
    common/include/utils
    api/include
    software/include
    ../../../pxshared/include
    ../../include
    ../common/src
    ../foundation/include
    ../geomutils/src
    ../geomutils/src/convex
    ../geomutils/include
    ../geomutils/include
    ../geomutils/src
    ../geomutils/src/common
    ../geomutils/src/gjk
    ../geomutils/src/convex
    ../geomutils/src/hf
    ../geomutils/src/ccd
    ../geomutils/src/contact
    ../geomutils/src/cooking
    ../geomutils/src/distance
    ../geomutils/src/intersection
    ../geomutils/src/mesh
    ../geomutils/src/pcm
    ../geomutils/src/sweep
    ../physx/include
    ../lowleveldynamics/include
    ../physxgpu/include
]

Compiler.Includes.Export api/include software/include common/include

Compiler.Defines $PxSharedDefines

if windows Compiler.Defines $PxWindowsDefines _LIB
