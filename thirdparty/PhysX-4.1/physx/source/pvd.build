option.Mode(Release Debug)

include ../physx_%-(mode).buildvariables

Compiler:windows  cl
Compiler:!windows clang

Assembly PhysXPvdSDK_static_64
Extension lib

IntermediateDirectory ../int/%_FileName
BuildDirectory ../Build/%Mode

SourceDirectories pvd physxmetadata

Compiler.Flags   $PxCompilerFlags /Gd /GR- /GS- /fp:fast /wd4514 /wd4820 /wd4127 /wd4710 /wd4711 /wd4577 /wd4996
Linker.Flags     $PxLinkerFlags
Linker.Subsystem Console

Compiler.Includes [
    pvd/include
    pvd/src
    ../../pxshared/include
    ../include
    common/include
    common/src
    foundation/include
    foundation/include
    physxmetadata/extensions/include
    physxmetadata/core/include
    filebuf/include
]

Compiler.Defines $PxSharedDefines PX_PHYSX_STATIC_LIB

if windows Compiler.Defines $PxWindowsDefines _LIB
