import thirdparty/%(Mode).buildvariables

Depends thirdparty/SDL2 | %mode
Depends thirdparty/fmt  | %mode cl
Depends $PhysXPath      | mode=%mode

Compiler              cl
Assembly              Kinema-%Mode
.run

SourceDirectory       source
BuildDirectory        data
IntermediateDirectory int/%Mode
PhysXBase             thirdparty/PhysX-4.1
PhysXPath             $(PhysXBase)/physx

Engine.cpp.Compiler.Flags /FIchrono

Compiler.Flags        $SharedCompilerFlags
Compiler.Defines      $SharedDefines IMGUI_IMPL_OPENGL_LOADER_GLAD
Linker.Flags          $SharedLinkerFlags /subsystem:windows

# Dependency includes, libraries and library paths propagate automatically
# from the Depends above (via their .Export keys).
Compiler.Includes
[
    source
    thirdparty
]

Libraries &NativeLibs

PostBuild
{
    Copy thirdparty/SDL2/bin/%Mode/SDL2.dll                 $BuildDirectory/
    Copy $(PhysXPath)/Build/%Mode/PhysXFoundation_64.dll    $BuildDirectory/
    Copy $(PhysXPath)/Build/%Mode/PhysXCommon_64.dll        $BuildDirectory/
    Copy $(PhysXPath)/Build/%Mode/PhysXCooking_64.dll       $BuildDirectory/
    Copy $(PhysXPath)/Build/%Mode/PhysX_64.dll              $BuildDirectory/
}

if mode == debug PostBuild
{
    Copy $(PhysXPath)/Build/%Mode/PhysXFoundation_64.pdb    $BuildDirectory/
    Copy $(PhysXPath)/Build/%Mode/PhysXCommon_64.pdb        $BuildDirectory/
    Copy $(PhysXPath)/Build/%Mode/PhysXCooking_64.pdb       $BuildDirectory/
    Copy $(PhysXPath)/Build/%Mode/PhysX_64.pdb              $BuildDirectory/
}

option.mode(Release Debug)

Assert.Platform windows
